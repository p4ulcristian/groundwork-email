;; groundwork-email: groundwork's email. An email the app has written is queued in the
;; caller's transaction as a background job (groundwork-background-jobs), sent by a provider
;; (Postmark, or the log), once; bounces, spam complaints and inbound email
;; come back on two webhooks. One tree: source-code/groundwork_email/.
{:paths ["source-code"]

 :deps
 {;; the sending: a background job, queued in the caller's transaction
  ;; on its tidy-up branch, not released: a job kind names its system actor; its tables
  ;; in groundwork-postgres's tidy-up shapes; a job's transaction carries its log
  io.github.p4ulcristian/groundwork-background-jobs {:git/tag "v0.5.7" :git/sha "c19386e"}
  ;; the emails table, a map for groundwork-postgres, and its queries
  ;; on its tidy-up branch, not released: a table map writes out :uniques and :checks,
  ;; a reference what it does on delete, update and when checked, an index as a map;
  ;; migrate! takes {:tables :extensions :functions :views}; run-in-transaction! takes the
  ;; caller's :log
  io.github.p4ulcristian/groundwork-postgres   {:git/tag "v0.4.7" :git/sha "d6f226c"}
  ;; an email kept in its background job, Postmark's JSON and the webhooks', by the app's shaper
  io.github.p4ulcristian/groundwork-shaped-json     {:git/tag "v0.2.2" :git/sha "1c0fcf9"}
  ;; the app's log, handed in
  io.github.p4ulcristian/groundwork-logs  {:git/tag "v0.1.3" :git/sha "8d1846e"}
  ;; the app's meter, handed in: emails queued, sent and failed by tag, webhook events
  io.github.p4ulcristian/groundwork-metrics    {:git/tag "v0.1.5" :git/sha "1cffe8e"}
  ;; Postmark's server token and the webhooks' token, secrets that print as their names
  io.github.p4ulcristian/groundwork-settings     {:git/tag "v0.1.2" :git/sha "25dfbf7"}
  ;; the settings, options and emails, checked before anything is queued
  metosin/malli                  {:mvn/version "0.20.3"}}

 :aliases
 {;; the tests:  clojure -X:test  (the Postgres ones need EMAIL_TEST_PORT, see README.md)
  :test {:extra-paths ["test-code"]
         :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :exec-fn     cognitect.test-runner.api/test
         :exec-args   {:dirs ["test-code"]}}}}
